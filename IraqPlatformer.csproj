<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets/hamoudi.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Content/LevelMaps.md" />
    <EmbeddedResource Include="assets/halabja-valley.png" LogicalName="HalabjaValley" />
    <EmbeddedResource Include="assets/lantern-giant.png" LogicalName="LanternGiant" />
    <EmbeddedResource Include="ArtReference/maps-*.png">
      <LogicalName>%(Filename)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ArtReference/heroes-01-05.png" LogicalName="HamoudiReference" />
    <EmbeddedResource Include="assets/heroes/*.jpg">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
